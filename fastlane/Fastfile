default_platform(:ios)

# Auth: ASC-API-Key (Key-Datei liegt NUR auf dem Mac Studio unter
# ~/.appstoreconnect/private_keys/ — nie ins Repo!)
platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: "V7L56GN3N8",
      issuer_id: "69a6de82-3ffb-47e3-e053-5b8c7c11a4d1",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_V7L56GN3N8.p8")
    )
  end

  desc "App in Dev-Portal + App Store Connect anlegen"
  lane :createapp do
    create_app_online(
      app_identifier: "at.legasthenie.sichtwort",
      app_name: "Sichtwort",
      language: "de-DE",
      sku: "at.legasthenie.sichtwort",
      app_version: "1.0"
    )
  end

  desc "App-Store-Provisioning-Profil ziehen und installieren"
  lane :profile do
    sigh(app_identifier: "at.legasthenie.sichtwort", output_path: "build")
  end

  desc "Build der internen Testgruppe zuweisen"
  lane :distribute do |o|
    app = Spaceship::ConnectAPI::App.find("at.legasthenie.sichtwort")
    build = app.get_builds(includes: "betaGroups").find { |b| b.version == (o[:build] || "17").to_s }
    UI.user_error!("Build nicht gefunden") unless build
    app.get_beta_groups.each do |g|
      UI.message("Gruppe: #{g.name} intern=#{g.is_internal_group}")
    end
    grp = app.get_beta_groups.find { |g| g.is_internal_group }
    if grp
      build.add_beta_groups(beta_groups: [grp]) rescue UI.message("schon zugewiesen")
      UI.success("Build #{build.version} -> #{grp.name}")
    end
  end

  desc "TestFlight-Builds auflisten (Verifikation nach dem Upload)"
  lane :builds do
    app = Spaceship::ConnectAPI::App.find("at.legasthenie.sichtwort")
    app.get_builds(includes: "preReleaseVersion,buildBetaDetail").first(5).each do |b|
      state = b.build_beta_detail&.external_build_state || b.processing_state
      UI.message("Build #{b.version} (#{b.pre_release_version&.version}) -> #{state}")
    end
  end

  desc "IPA nach TestFlight hochladen"
  lane :upload do
    pilot(
      ipa: "build/export/Sichtwort.ipa",
      app_identifier: "at.legasthenie.sichtwort",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Privacy-Label setzen (keine Datenerfassung)"
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      app_identifier: "at.legasthenie.sichtwort",
      json_path: "fastlane/app_privacy_details.json"
    )
  end

  desc "Metadaten + Screenshots hochladen (ohne Binary)"
  lane :meta do
    deliver(
      app_identifier: "at.legasthenie.sichtwort",
      force: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false
    )
  end
end
